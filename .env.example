# Kable Quiz Backend – set ALL of these on Render (Environment) for production.
# Copy to .env for local dev; never commit .env.

PORT=4000
BASE_URL=https://your-backend.onrender.com
FRONTEND_URL=https://quiz-frontend-mnq4.onrender.com
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/

# Pass/fail email (Microsoft Graph)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_SENDER_EMAIL=

# Passed users: link to schedule acceptance call
PASS_URL=https://ka.kableacademy.com/meetings/...
QUIZ_PASS_PERCENT=60

# HubSpot OAuth (redirect must match Render backend URL)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=https://your-backend.onrender.com/api/auth/callback
# Deal stage IDs (internal HubSpot stage IDs for your pipeline)
HUBSPOT_ACCEPTANCE_STAGE_ID=
# Optional alias: HUBSPOT_STAGE_ACCEPTANCE_LETTER=
HUBSPOT_ASSESSMENTS_STAGE_ID=
# Optional alias: HUBSPOT_STAGE_ASSESSMENTS=
HUBSPOT_PIPELINE_ID=default
